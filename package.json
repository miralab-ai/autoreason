{
  "name": "autoreason",
  "version": "1.0.0",
  "description": "",
  "exports": "./src/cli.ts",
  "bin": "./dist/src/cli.js",
  "type": "module",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "prettier --check . && xo && ava",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai"
  ],
  "files": [
    "dist"
  ],
  "author": "Arda Sevinc <arda@ardasevinc.com>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.14.2+sha512.6e2baf77d06b9362294152c851c4f278ede37ab1eba3a55fda317a4a17b209f4dbb973fb250a77abc463a341fcb1f17f17cfa24091c4eb319cda0d9b84278387",
  "prettier": "@ardasevinc/prettier-config",
  "devDependencies": {
    "@ardasevinc/prettier-config": "^0.1.5",
    "@sindresorhus/tsconfig": "^7.0.0",
    "ava": "^6.4.1",
    "chalk": "^5.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "xo": "^0.60.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "dotenv": "^16.6.1",
    "meow": "^13.2.0",
    "openai": "^4.104.0"
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "xo": {
    "prettier": true,
    "rules": {
      "n/prefer-global/process": 0
    }
  },
  "pnpm": {
    "overrides": {
      "glob@10": "^14.0.2",
      "minimatch@9": "^11.0.1",
      "webpack": "^5.104.1"
    }
  }
}
